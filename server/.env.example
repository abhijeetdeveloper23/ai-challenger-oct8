# Server
PORT=5001
NODE_ENV=development
# Frontend origin only — no trailing slash. Comma-separate multiple.
# CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lead-intelligence

# Demo mode — force local demo dataset only
DEMO_MODE=false

# --- Multi-source discovery ---
# Comma-separated providers to query in parallel, then merge + dedupe:
#   serpapi,google_places,foursquare
# If all fail or return empty, demo dataset is used automatically.
DISCOVERY_PROVIDERS=serpapi,google_places,foursquare

# Backward-compatible single provider (used if DISCOVERY_PROVIDERS is empty)
# Values: demo | serpapi | google_places | foursquare | multi
DISCOVERY_PROVIDER=multi

# SerpAPI (Google Maps local results)
DISCOVERY_API_KEY=

# Google Places API (New) — Text Search
GOOGLE_PLACES_API_KEY=

# Foursquare Places API v3 service key
FOURSQUARE_API_KEY=

# Website analysis (third insight source — homepage signals)
WEBSITE_TIMEOUT_MS=5000
WEBSITE_CONCURRENCY=3

# Optional AI sales insights (not required for core scoring)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
